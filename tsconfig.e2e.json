{
  // Playwright specs run in Node, but callbacks passed to page.evaluate() run in the browser,
  // so they need DOM types that the other Node files shouldn't see.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["tests/e2e/**/*.ts"]
}
